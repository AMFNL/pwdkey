<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!--
      说明（重要）：
      1) 本应用完全离线，因此**不申请 INTERNET 权限** —— 在系统层面就不可能联网。
         Capacitor 通过 WebViewAssetLoader 从 APK 内 assets 加载页面，不需要网络权限。
      2) 蓝牙权限按 Android 12 (API 31) 的新模型声明：SCAN 标记 neverForLocation，
         因此不需要定位权限；Android 11 及以下仍走旧的 BLUETOOTH / 定位权限。
      3) allowBackup=false：设备配对信息不进入系统云备份。
      4) DUMP 权限由依赖合并带入，已用 tools:node="remove" 移除。
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- ==== 蓝牙（Android 12+）==== -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:node="replace" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:node="replace" />

    <!-- ==== 蓝牙（Android 11 及以下）==== -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"
        tools:node="replace" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"
        tools:node="replace" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30"
        tools:node="replace" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30"
        tools:node="replace" />

    <!-- 按键确认时的轻震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ==== 生物认证（v1.1）====
         普通权限，不涉及网络，也不影响下面“移除 INTERNET 权限”的声明。
         实际是否可用由 BiometricManager.canAuthenticate(BIOMETRIC_STRONG) 决定。 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- 生物识别硬件不是必需：没有的机型自动回落到主密码 -->
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <!-- 显式声明不使用网络（Capacitor 模板默认会加，这里移除） -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- 依赖（Capacitor / BLE 插件）在清单合并时会带入 DUMP。
         该权限是 signature|privileged 级，普通安装拿不到，但对一个密码管理器来说
         出现在权限列表里既不必要又容易引起误解，这里显式移除。 -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:node="remove" />
</manifest>
