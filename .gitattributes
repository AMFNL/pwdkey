# 统一行尾，避免 Windows / macOS / Linux 协作时整文件 diff
* text=auto eol=lf

# Windows 脚本必须是 CRLF，否则 cmd.exe 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.jks binary
*.keystore binary
*.apk binary
*.bin binary
*.a binary
*.zip binary

# 这些是生成物，diff 无意义，也避免在 GitHub 上占篇幅
package-lock.json linguist-generated=true
pwdkey_android/www/js/app.bundle.js linguist-generated=true
