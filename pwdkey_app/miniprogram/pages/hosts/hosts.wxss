.page { padding-bottom: 60rpx; }

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 8rpx;
}
.topbar-title { font-size: 40rpx; font-weight: 700; }
.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eef2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.list-card { padding: 8rpx 32rpx; }

.host {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.host:last-child { border-bottom: none; }
.host-off .host-icon { background: #f1f5f9; }
.host-off .host-name { color: #64748b; }

.host-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #eff6ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.host-body { flex: 1; min-width: 0; }
.host-name {
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 400;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.host-mac { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; }

.host-status { flex-shrink: 0; text-align: center; width: 96rpx; }
.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin: 0 auto 6rpx;
}
.dot-on { background: #10b981; }
.dot-off { background: #cbd5e1; }
.host-status-text { font-size: 22rpx; color: #6b7280; }

.empty { text-align: center; padding: 60rpx 0; }
.empty-icon { font-size: 72rpx; margin-bottom: 12rpx; }

.err-box {
  color: #dc2626;
  background: #fef2f2;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 16rpx 0;
  font-size: 26rpx;
}

.hint { padding: 8rpx 48rpx; text-align: center; line-height: 1.7; }
