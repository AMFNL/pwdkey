.page { padding-bottom: 60rpx; }

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 8rpx;
}
.topbar-title { font-size: 40rpx; font-weight: 700; }
.topbar-actions { display: flex; }
.topbar-actions .icon-btn + .icon-btn { margin-left: 16rpx; }
.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eef2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.list-card { padding: 8rpx 32rpx; }

.entry {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.entry:last-child { border-bottom: none; }
.entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #eff6ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.entry-body { flex: 1; min-width: 0; }
.entry-name {
  font-size: 30rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.entry-id { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; }
.entry-arrow { color: #cbd5e1; font-size: 40rpx; margin-left: 12rpx; }

.empty { text-align: center; padding: 60rpx 0; }
.empty-icon { font-size: 72rpx; margin-bottom: 12rpx; }

.err-box {
  color: #dc2626;
  background: #fef2f2;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 16rpx 0;
  font-size: 26rpx;
}

.hint { padding: 8rpx 48rpx; text-align: center; line-height: 1.7; }
